# Required for production deployments; replace these placeholder values.
JWT_SECRET=replace-with-a-long-random-secret
POSTGRES_PASSWORD=replace-with-a-strong-password

# Optional environment variables (Docker defaults are used when omitted).
# app
APP_PORT=8080

# server
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:8080
APP_URL=http://localhost:8080

# Push notifications (configure both keys to enable push).
# Generate VAPID keys with `npx web-push generate-vapid-keys` before enabling push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@habitmaker.local

# db (PostgreSQL is optional; when omitted, the API uses in-memory sql.js).
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=habitmaker
POSTGRES_DB=habitmaker

# Set both to create an initial administrator account.
ADMIN_EMAIL=admin@habitmaker.local
ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-8-characters

# Email delivery (configure these to enable email).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Use "smtp" for SMTP with STARTTLS, or "smtps" for implicit TLS.
SMTP_PROTOCOL=smtp
SMTP_USER=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=no-reply@habitmaker.local
