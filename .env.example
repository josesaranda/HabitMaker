# app environment variables
APP_PORT=8080

# server environment variables
SERVER_PORT=3000
CORS_ORIGIN=http://localhost:8080
JWT_SECRET=replace-with-a-long-random-secret

# db environment variables
# PostgreSQL (optional; when omitted, the API uses in-memory sql.js)
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_USER=habitmaker
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=habitmaker

# user environment variables
ADMIN_EMAIL=admin@habitmaker.local
ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-8-characters

# email environment variables
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# Use "smtp" for SMTP with STARTTLS, or "smtps" for implicit TLS.
SMTP_PROTOCOL=smtp
SMTP_USER=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=no-reply@habitmaker.local
