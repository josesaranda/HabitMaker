# NestJS server
SERVER_PORT=3000
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-bytes
CORS_ORIGIN=http://localhost:4200
ADMIN_EMAIL=admin@habitmaker.local
ADMIN_PASSWORD=replace-with-a-unique-admin-password-at-least-8-characters

# PostgreSQL (optional; when omitted, the API uses in-memory sql.js)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=habitmaker
POSTGRES_PASSWORD=replace-with-your-database-password
POSTGRES_DB=habitmaker
