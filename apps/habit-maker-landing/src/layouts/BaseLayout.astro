---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  lang: 'en' | 'es';
  title?: string;
  description?: string;
}

const { lang, title, description } = Astro.props;
const siteUrl = Astro.site ?? Astro.url;
const englishUrl = new URL('/', siteUrl).href;
const spanishUrl = new URL('/es/', siteUrl).href;
const canonicalUrl = lang === 'es' ? spanishUrl : englishUrl;
const socialImage = new URL(
  lang === 'es' ? '/social-card-es.png' : '/social-card-en.png',
  siteUrl,
).href;
const socialImageAlt =
  lang === 'es'
    ? 'HabitMaker: pequeños hábitos, cambios que importan.'
    : 'HabitMaker: small habits, meaningful change.';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f3f1e9" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="HabitMaker" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta
      property="og:locale:alternate"
      content={lang === 'es' ? 'en_US' : 'es_ES'}
    />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={socialImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={englishUrl} />
    <link rel="alternate" hreflang="es" href={spanishUrl} />
    <link rel="alternate" hreflang="x-default" href={englishUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      rel="preconnect"
      href="https://fonts.gstatic.com"
      crossorigin="anonymous"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Fraunces:opsz,wght@9..144,500;9..144,600&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Analytics />
  </head>
  <body>
    <slot />
  </body>
</html>
