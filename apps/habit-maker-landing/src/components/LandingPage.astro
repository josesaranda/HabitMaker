---
import BaseLayout from '../layouts/BaseLayout.astro';
import LanguagePicker from './LanguagePicker.astro';
import { defaultLang, type Lang } from '../i18n/ui';
import { useTranslations } from '../i18n/utils';

interface Props {
  lang?: Lang;
}

const { lang = defaultLang } = Astro.props;
const copy = useTranslations(lang);

const repository = 'https://github.com/josesaranda/HabitMaker';

const previews = copy.previews.map((preview, index) => ({
  ...preview,
  image: [
    '/screenshots/home.svg',
    '/screenshots/calendar.svg',
    '/screenshots/reminders.svg',
  ][index],
  number: `0${index + 1}`,
}));
const dockerCommands = [
  undefined,
  'git clone https://github.com/josesaranda/HabitMaker.git\ncd HabitMaker\ncp .env.example .env',
  'docker compose up --build -d',
  'http://localhost:8080',
];
const dockerSteps = copy.dockerSteps.map((step, index) => ({
  ...step,
  number: `0${index + 1}`,
  command: dockerCommands[index],
}));
---

<BaseLayout lang={lang} title={copy.title} description={copy.description}>
  <a class="skip-link" href="#main">
    {copy.skip}
  </a>

  <header class="relative z-10 mx-auto flex max-w-7xl items-center justify-between px-5 py-5 sm:px-8 lg:px-12">
    <a
      class="inline-flex items-center gap-2.5 rounded-full text-forest no-underline"
      href="#top"
      aria-label={copy.title}
    >
      <span
        class="grid size-10 place-items-center rounded-full bg-forest text-cream"
        aria-hidden="true"
      >
        <svg viewBox="0 0 24 24" class="size-6" fill="none">
          <path
            d="M12 20v-8m0 4c0-5-3-8-7-8 0 4 2 7 7 8Zm0-3c0-5 3-8 7-8 0 4-2 7-7 8Z"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.7"
          />
        </svg>
      </span>
      <span class="text-lg font-bold tracking-tight">
        habit<span class="font-medium">maker</span>
      </span>
    </a>

    <nav
      aria-label={copy.navLabel}
      class="hidden items-center gap-8 text-sm font-medium text-forest/75 md:flex"
    >
      <a class="rounded-sm transition hover:text-forest" href="#why">
        {copy.navWhy}
      </a>
      <a class="rounded-sm transition hover:text-forest" href="#screenshots">
        {copy.navScreenshots}
      </a>
      <a class="rounded-sm transition hover:text-forest" href="#docker">
        {copy.navDocker}
      </a>
    </nav>

    <LanguagePicker
      lang={lang}
      label={copy.languageLabel}
      switchToEnglish={copy.switchToEnglish}
      switchToSpanish={copy.switchToSpanish}
      class="hidden md:flex"
    />

    <a
      class="inline-flex min-h-11 items-center gap-2 rounded-full bg-forest px-5 text-sm font-semibold text-white no-underline transition hover:bg-forest-soft focus-visible:outline-offset-4"
      href={repository}
      target="_blank"
      rel="noreferrer"
    >
      <svg
        viewBox="0 0 24 24"
        class="size-4"
        fill="currentColor"
        aria-hidden="true"
      >
        <path d="M12 .9a11.1 11.1 0 0 0-3.51 21.63c.56.1.76-.24.76-.54v-2.1c-3.1.67-3.75-1.32-3.75-1.32-.5-1.28-1.24-1.62-1.24-1.62-1.02-.7.08-.69.08-.69 1.12.08 1.71 1.15 1.71 1.15 1 1.7 2.63 1.21 3.27.92.1-.72.4-1.21.71-1.49-2.47-.28-5.07-1.24-5.07-5.5 0-1.22.44-2.22 1.15-3.01-.12-.28-.5-1.43.11-2.97 0 0 .94-.3 3.06 1.15a10.7 10.7 0 0 1 5.57 0c2.12-1.44 3.05-1.15 3.05-1.15.61 1.54.23 2.69.12 2.97.71.79 1.14 1.8 1.14 3.02 0 4.27-2.6 5.2-5.08 5.48.4.35.76 1.03.76 2.08v3.08c0 .3.2.65.77.54A11.1 11.1 0 0 0 12 .9Z" />
      </svg>
      <span class="hidden sm:inline">{copy.viewGithub}</span>
      <span class="sm:hidden">{copy.githubShort}</span>
    </a>
  </header>

  <nav
    aria-label={copy.navLabel}
    class="mx-auto flex max-w-7xl gap-6 overflow-x-auto px-5 pb-3 text-xs font-semibold text-forest/70 sm:px-8 md:hidden"
  >
    <a class="shrink-0 rounded-sm py-1 hover:text-forest" href="#why">
      {copy.navWhy}
    </a>
    <a class="shrink-0 rounded-sm py-1 hover:text-forest" href="#screenshots">
      {copy.navScreenshots}
    </a>
    <a class="shrink-0 rounded-sm py-1 hover:text-forest" href="#docker">
      {copy.navDocker}
    </a>
    <LanguagePicker
      lang={lang}
      label={copy.languageLabel}
      switchToEnglish={copy.switchToEnglish}
      switchToSpanish={copy.switchToSpanish}
      class="ml-auto shrink-0 md:hidden"
    />
  </nav>

  <main id="main">
    <section
      id="top"
      class="relative isolate overflow-hidden px-5 pb-20 pt-10 sm:px-8 sm:pb-28 sm:pt-16 lg:px-12 lg:pb-32 lg:pt-20"
    >
      <div
        class="pointer-events-none absolute -right-44 -top-32 -z-10 size-[34rem] rounded-full bg-[radial-gradient(circle,#d6e3d6_0%,transparent_68%)] opacity-80"
        aria-hidden="true"
      ></div>
      <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:gap-16">
        <div class="max-w-2xl">
          <p class="mb-6 inline-flex items-center gap-2 rounded-full border border-forest/10 bg-white/55 px-3.5 py-2 text-xs font-semibold uppercase tracking-[0.14em] text-forest-soft">
            <span
              class="size-2 rounded-full bg-forest-soft"
              aria-hidden="true"
            ></span>
            {copy.heroTag}
          </p>
          <h1 class="max-w-xl font-display text-[clamp(3.5rem,8vw,6.5rem)] leading-[0.94] tracking-[-0.065em] text-forest">
            {copy.heroHeadingFirst}
            <br />
            {copy.heroHeadingSecond}{' '}
            <span class="relative inline-block whitespace-nowrap">
              {copy.heroHighlight}
              <span
                class="absolute -bottom-1 left-0 -z-10 h-3 w-full -rotate-2 rounded-full bg-amber/70"
                aria-hidden="true"
              ></span>
            </span>
          </h1>
          <p class="mt-7 max-w-lg text-lg leading-8 text-forest/70 sm:text-xl sm:leading-9">
            {copy.heroDescription}
          </p>
          <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a
              class="inline-flex min-h-14 items-center justify-center gap-3 rounded-full bg-forest px-7 text-base font-semibold text-white no-underline shadow-[0_12px_28px_rgb(23_47_43_/_18%)] transition hover:-translate-y-0.5 hover:bg-forest-soft focus-visible:outline-offset-4"
              href="#docker"
            >
              {copy.startDocker}
              <svg
                viewBox="0 0 20 20"
                class="size-4"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 10h12m-5-5 5 5-5 5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.7"
                />
              </svg>
            </a>
            <a
              class="inline-flex min-h-14 items-center justify-center rounded-full px-5 text-sm font-semibold text-forest no-underline underline decoration-forest/25 underline-offset-4 transition hover:decoration-forest"
              href="#screenshots"
            >
              {copy.explore}
            </a>
          </div>
          <div class="mt-9 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm text-forest/60">
            <span class="inline-flex items-center gap-2">
              <svg
                viewBox="0 0 20 20"
                class="size-4 text-forest-soft"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="m4 10 4 4 8-8"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.8"
                />
              </svg>
              {copy.openSource}
            </span>
            <span
              class="hidden size-1 rounded-full bg-forest/25 sm:block"
              aria-hidden="true"
            ></span>
            <span class="inline-flex items-center gap-2">
              <svg
                viewBox="0 0 20 20"
                class="size-4 text-forest-soft"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M10 2.5 3.5 5v4.6c0 4.2 2.8 6.7 6.5 7.9 3.7-1.2 6.5-3.7 6.5-7.9V5L10 2.5Z"
                  stroke="currentColor"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                />
                <path
                  d="m7 10 2 2 4-4"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.5"
                />
              </svg>
              {copy.selfHostable}
            </span>
          </div>
        </div>

        <div class="relative mx-auto w-full max-w-[650px] lg:ml-auto">
          <div class="absolute -left-4 top-14 z-10 hidden -rotate-6 rounded-2xl border border-white/80 bg-white/85 px-4 py-3 shadow-[0_18px_45px_rgb(23_47_43_/_12%)] backdrop-blur sm:block lg:-left-8">
            <span class="block text-[11px] font-semibold uppercase tracking-[0.12em] text-forest/45">
              {copy.littleAddsUp}
            </span>
            <span class="mt-1 block font-display text-2xl text-forest">
              {copy.daysShowingUp} <span class="text-amber">✳</span>
            </span>
          </div>
          <div class="relative overflow-hidden rounded-[2rem] border border-white/80 bg-[#dfe7dc] p-2 shadow-[0_35px_80px_rgb(23_47_43_/_16%)] sm:rounded-[2.5rem] sm:p-3">
            <div
              class="grain absolute inset-0 opacity-[0.14]"
              aria-hidden="true"
            ></div>
            <img
              class="relative block w-full rounded-[1.45rem] sm:rounded-[1.9rem]"
              src="/screenshots/home.svg"
              alt={copy.heroImageAlt}
              width="960"
              height="620"
              fetchpriority="high"
            />
          </div>
          <div class="absolute -bottom-7 -right-2 flex -rotate-3 items-center gap-3 rounded-2xl border border-white/70 bg-white px-4 py-3 shadow-[0_16px_40px_rgb(23_47_43_/_12%)] sm:-right-5 sm:px-5 sm:py-4">
            <span
              class="grid size-10 place-items-center rounded-full bg-[#e7eee4] text-xl"
              aria-hidden="true"
            >
              🌱
            </span>
            <span>
              <span class="block text-xs font-medium text-forest/50">
                {copy.oneDayAtATime}
              </span>
              <span class="block text-sm font-bold text-forest">
                {copy.yourProgress}
              </span>
            </span>
          </div>
        </div>
      </div>
      <div class="mx-auto mt-24 flex max-w-7xl flex-wrap items-center justify-center gap-x-4 gap-y-2 border-t border-forest/10 pt-6 text-center text-xs font-semibold uppercase tracking-[0.15em] text-forest/45 sm:mt-28 sm:justify-between sm:text-left">
        <span>{copy.proofOne}</span>
        <span
          class="hidden h-px max-w-40 flex-1 bg-forest/10 sm:block"
          aria-hidden="true"
        ></span>
        <span>{copy.proofTwo}</span>
      </div>
    </section>

    <section
      id="why"
      class="bg-forest px-5 py-20 text-cream sm:px-8 sm:py-28 lg:px-12"
    >
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-20">
        <div>
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-leaf">
            {copy.whyEyebrow}
          </p>
          <h2 class="max-w-lg font-display text-4xl leading-tight tracking-[-0.04em] sm:text-5xl">
            {copy.whyHeading}
          </h2>
        </div>
        <div class="grid gap-8 sm:grid-cols-2 sm:gap-10">
          <article>
            <span
              class="mb-4 grid size-11 place-items-center rounded-full bg-white/10 text-amber"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none">
                <path
                  d="M12 3v18m0-14c-4 0-6 2-6 5 0 2 2 4 6 4m0-5c4 0 6-2 6-5-4 0-6 2-6 5Z"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                />
              </svg>
            </span>
            <h3 class="text-lg font-semibold">{copy.features[0].title}</h3>
            <p class="mt-2 text-sm leading-6 text-cream/65">
              {copy.features[0].description}
            </p>
          </article>
          <article>
            <span
              class="mb-4 grid size-11 place-items-center rounded-full bg-white/10 text-amber"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none">
                <rect
                  x="3"
                  y="4"
                  width="18"
                  height="17"
                  rx="3"
                  stroke="currentColor"
                  stroke-width="1.6"
                />
                <path
                  d="M16 2v4M8 2v4M3 9h18m-13 5 2 2 5-5"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                />
              </svg>
            </span>
            <h3 class="text-lg font-semibold">{copy.features[1].title}</h3>
            <p class="mt-2 text-sm leading-6 text-cream/65">
              {copy.features[1].description}
            </p>
          </article>
          <article>
            <span
              class="mb-4 grid size-11 place-items-center rounded-full bg-white/10 text-amber"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none">
                <path
                  d="M18 9a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9Zm-8 13h4"
                  stroke="currentColor"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                />
              </svg>
            </span>
            <h3 class="text-lg font-semibold">{copy.features[2].title}</h3>
            <p class="mt-2 text-sm leading-6 text-cream/65">
              {copy.features[2].description}
            </p>
          </article>
          <article>
            <span
              class="mb-4 grid size-11 place-items-center rounded-full bg-white/10 text-amber"
              aria-hidden="true"
            >
              <svg viewBox="0 0 24 24" class="size-5" fill="none">
                <path
                  d="M12 21s-8-4.5-8-11a4.5 4.5 0 0 1 8-2.8A4.5 4.5 0 0 1 20 10c0 6.5-8 11-8 11Z"
                  stroke="currentColor"
                  stroke-linejoin="round"
                  stroke-width="1.6"
                />
              </svg>
            </span>
            <h3 class="text-lg font-semibold">{copy.features[3].title}</h3>
            <p class="mt-2 text-sm leading-6 text-cream/65">
              {copy.features[3].description}
            </p>
          </article>
        </div>
      </div>
    </section>

    <section id="screenshots" class="px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
      <div class="mx-auto max-w-7xl">
        <div class="flex flex-col justify-between gap-5 sm:flex-row sm:items-end">
          <div class="max-w-2xl">
            <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-forest-soft">
              {copy.screenshotsEyebrow}
            </p>
            <h2 class="font-display text-4xl tracking-[-0.045em] text-forest sm:text-5xl">
              {copy.screenshotsHeading}
            </h2>
          </div>
          <p class="max-w-sm text-sm leading-6 text-forest/60">
            {copy.screenshotsIntro}
          </p>
        </div>

        <div class="mt-12 grid gap-5 md:grid-cols-3 md:gap-6">
          {previews.map((preview) => (
            <article class="group overflow-hidden rounded-[1.75rem] border border-forest/10 bg-white shadow-[0_14px_40px_rgb(23_47_43_/_5%)]">
              <div class="overflow-hidden bg-[#e8ece4] p-3 sm:p-4">
                <img
                  class="aspect-[1.52] w-full rounded-xl object-cover transition duration-500 group-hover:scale-[1.025]"
                  src={preview.image}
                  alt={preview.alt}
                  width="800"
                  height="520"
                  loading="lazy"
                />
              </div>
              <div class="flex gap-4 p-5 sm:p-6">
                <span class="pt-1 text-xs font-bold tracking-[0.12em] text-forest-soft/55">
                  {preview.number}
                </span>
                <div>
                  <h3 class="text-base font-bold text-forest">
                    {preview.title}
                  </h3>
                  <p class="mt-1.5 text-sm leading-6 text-forest/60">
                    {preview.description}
                  </p>
                </div>
              </div>
            </article>
          ))}
        </div>
        <p class="mt-5 text-xs text-forest/45">{copy.screenshotsNote}</p>
      </div>
    </section>

    <section
      id="docker"
      class="relative isolate overflow-hidden bg-[#e3e9df] px-5 py-20 sm:px-8 sm:py-28 lg:px-12"
    >
      <div
        class="pointer-events-none absolute -bottom-48 -left-32 -z-10 size-[32rem] rounded-full bg-[radial-gradient(circle,#c8d8c6_0%,transparent_70%)]"
        aria-hidden="true"
      ></div>
      <div class="mx-auto grid max-w-7xl gap-12 lg:grid-cols-[0.78fr_1.22fr] lg:gap-20">
        <div class="lg:sticky lg:top-10 lg:self-start">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-forest-soft">
            {copy.dockerEyebrow}
          </p>
          <h2 class="max-w-lg font-display text-4xl leading-tight tracking-[-0.045em] text-forest sm:text-5xl">
            {copy.dockerHeading}
          </h2>
          <p class="mt-5 max-w-md text-base leading-7 text-forest/65">
            {copy.dockerDescription}
          </p>
          <div class="mt-7 rounded-2xl border border-forest/10 bg-white/60 p-5">
            <p class="text-sm font-bold text-forest">
              {copy.dockerPrerequisites}
            </p>
            <p class="mt-1 text-sm leading-6 text-forest/60">
              {copy.dockerRequirements}
            </p>
          </div>
          <a
            class="mt-6 inline-flex items-center gap-2 text-sm font-bold text-forest underline decoration-forest/30 underline-offset-4 transition hover:decoration-forest"
            href={`${repository}#run-with-docker`}
            target="_blank"
            rel="noreferrer"
          >
            {copy.readSetupGuide}{' '}
            <svg
              viewBox="0 0 20 20"
              class="size-4"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10h12m-5-5 5 5-5 5"
                stroke="currentColor"
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="1.7"
              />
            </svg>
          </a>
        </div>

        <ol class="relative m-0 list-none space-y-3 p-0">
          {dockerSteps.map((step) => (
            <li class="grid gap-3 rounded-2xl border border-forest/10 bg-white/75 p-5 sm:grid-cols-[2.5rem_1fr] sm:gap-5 sm:p-6">
              <span class="grid size-9 place-items-center rounded-full bg-forest text-xs font-bold tracking-wide text-cream">
                {step.number}
              </span>
              <div>
                <h3 class="text-base font-bold text-forest">{step.title}</h3>
                <p class="mt-1 text-sm leading-6 text-forest/60">
                  {step.description}
                </p>
                {step.command && <pre class="mt-4 overflow-x-auto rounded-xl bg-[#172f2b] p-4 text-xs leading-6 text-[#e6eddf]"><code>{step.command}</code></pre>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="contribute" class="px-5 py-20 sm:px-8 sm:py-28 lg:px-12">
      <div class="mx-auto max-w-7xl overflow-hidden rounded-[2rem] bg-[#d6e2d4] px-6 py-12 sm:px-12 sm:py-16 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:px-16">
        <div class="max-w-2xl">
          <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-forest-soft">
            {copy.contributeEyebrow}
          </p>
          <h2 class="font-display text-4xl leading-tight tracking-[-0.045em] text-forest sm:text-5xl">
            {copy.contributeHeading}
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-forest/65">
            {copy.contributeDescription}
          </p>
        </div>
        <div class="mt-8 flex shrink-0 flex-col gap-3 sm:flex-row lg:mt-0 lg:flex-col xl:flex-row">
          <a
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-forest px-6 text-sm font-bold text-white no-underline transition hover:bg-forest-soft"
            href={`${repository}/issues`}
            target="_blank"
            rel="noreferrer"
          >
            {copy.openIssue} <span aria-hidden="true">↗</span>
          </a>
          <a
            class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full border border-forest/20 bg-white/55 px-6 text-sm font-bold text-forest no-underline transition hover:bg-white"
            href={`${repository}/pulls`}
            target="_blank"
            rel="noreferrer"
          >
            {copy.submitPullRequest} <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="mx-auto mt-8 flex max-w-7xl flex-col gap-3 text-sm text-forest/60 sm:flex-row sm:items-center sm:justify-between">
        <p>
          {copy.notSureWhereToStart}{' '}
          <a
            class="font-semibold text-forest underline decoration-forest/25 underline-offset-4 hover:decoration-forest"
            href={`${repository}/issues`}
            target="_blank"
            rel="noreferrer"
          >
            {copy.openIssues}
          </a>{' '}
          {copy.joinConversation}
        </p>
        <a
          class="inline-flex w-fit items-center gap-2 font-bold text-forest no-underline hover:underline"
          href={`${repository}/blob/main/README.md`}
          target="_blank"
          rel="noreferrer"
        >
          {copy.readReadme} <span aria-hidden="true">↗</span>
        </a>
      </div>
    </section>
  </main>

  <footer class="border-t border-forest/10 px-5 py-7 sm:px-8 lg:px-12">
    <div class="mx-auto flex max-w-7xl flex-col gap-3 text-xs text-forest/50 sm:flex-row sm:items-center sm:justify-between">
      <p class="m-0">
        {copy.footerMadeWithCare}{' '}
        <span class="font-semibold text-forest/70">HabitMaker</span> is open
        source under the MIT license.
      </p>
      <div class="flex flex-wrap gap-x-5 gap-y-2">
        <a
          class="rounded-sm hover:text-forest"
          href={repository}
          target="_blank"
          rel="noreferrer"
        >
          {copy.repository}
        </a>
        <a
          class="rounded-sm hover:text-forest"
          href={`${repository}/blob/main/LICENSE`}
          target="_blank"
          rel="noreferrer"
        >
          {copy.license}
        </a>
        <a class="rounded-sm hover:text-forest" href="#top">
          {copy.backToTop}
        </a>
      </div>
    </div>
  </footer>
</BaseLayout>
