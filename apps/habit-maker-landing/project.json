{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "HabitMakerLanding",
  "projectType": "application",
  "sourceRoot": "apps/habit-maker-landing/src",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "cache": true,
      "outputs": ["{projectRoot}/dist"],
      "options": {
        "command": "astro build",
        "cwd": "apps/habit-maker-landing"
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "astro dev --host 0.0.0.0",
        "cwd": "apps/habit-maker-landing"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "command": "astro preview --host 0.0.0.0",
        "cwd": "apps/habit-maker-landing"
      }
    }
  },
  "tags": ["scope:landing", "type:app"]
}
