{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "rootDir": "../..",
    "module": "commonjs",
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "moduleResolution": "bundler"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx"
  ],
  "references": [
    {
      "path": "../../libs/habit-maker-api/push/api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/habit-maker-api/platform/infrastructure/tsconfig.lib.json"
    },
    {
      "path": "../../libs/habit-maker-api/version/api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/habit-maker-api/admin/api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/habit-maker-api/habits/api/tsconfig.lib.json"
    },
    {
      "path": "../../libs/habit-maker-api/auth/api/tsconfig.lib.json"
    }
  ]
}
